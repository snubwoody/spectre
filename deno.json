{
	"name": "@spectre/spectre",
	"version": "0.1.0-alpha",
	"exports": "./main.ts",
	"tasks": {
		"dev": "deno run -A --watch main.ts",
		"task": "deno test -A",
		"run": "deno run -A main.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@1",
		"puppeteer": "npm:puppeteer@^24.6.1"
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"deno.ns",
			"dom.asynciterable"
		]
	},
	"fmt": {
		"indentWidth": 4,
		"useTabs": true,
		"lineWidth": 60
	},
	"lint": {
		"rules": {
			"include": [
				"camelcase",
				"no-unused-vars"
			]
		}
	}
}
